# Normalize all text files to LF in the repository and on checkout.
# Prevents Windows checkouts from committing whole files as CRLF, which
# makes diffs show every line as changed.
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
